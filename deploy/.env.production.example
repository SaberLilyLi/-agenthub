# Copy this file to deploy/.env.production on the server. Do not commit the copy.
# Use a hostname only, without https:// or a trailing slash.
DOMAIN=agenthub.example.com

# Generate a unique value, for example: openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-a-unique-production-database-password

# The following signing secrets must each be unique and at least 32 characters.
# PAYLOAD_SECRET itself is stored in ../secrets/payload_secret, not in this file.
AUDIT_IP_HASH_SECRET=replace-with-a-unique-32-character-audit-hmac-secret
AUDIT_IP_HASH_KEY_VERSION=v1

# Security settings
CSRF_TRUSTED_ORIGINS=https://agenthub.example.com
TRUST_PROXY=true
HUMAN_VERIFICATION_REQUIRED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ARCHIVE_SCANNER_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# COS storage. Never place real credentials in Git.
DOWNLOAD_ALLOWED_HOSTS=example.cos.ap-guangzhou.myqcloud.com
TENCENT_COS_BUCKET=your-bucket-name
TENCENT_COS_REGION=ap-guangzhou
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
NEXT_PUBLIC_SITE_NAME=FaceMini AgentHub
NEXT_PUBLIC_SITE_DESCRIPTION=智能体应用发现与下载平台
