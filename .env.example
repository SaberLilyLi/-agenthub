# Use a deployment secret manager in production. For local Docker development,
# copy this file to .env and replace every placeholder with a unique value.
POSTGRES_PASSWORD=replace-with-a-unique-local-database-password
DATABASE_URI=postgresql://agenthub:replace-with-a-unique-local-database-password@postgres:5432/agenthub

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to sign Payload JWT tokens. Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Optional comma-separated browser origins allowed to write through the API.
# Leave empty for same-origin requests only.
CSRF_TRUSTED_ORIGINS=
# Cloudflare Turnstile. Production rejects protected writes until the secret is configured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set true locally after configuring both Turnstile keys. Production is always enforced.
HUMAN_VERIFICATION_REQUIRED=false
# ClamAV daemon used to scan every upload. RAR uploads are rejected without it.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Production always requires scanning; set true locally to fail closed as well.
ARCHIVE_SCANNER_REQUIRED=false

DOWNLOAD_ALLOWED_HOSTS=example.cos.ap-guangzhou.myqcloud.com,download.facemini.com
# Set TRUST_PROXY=true only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
AUDIT_IP_HASH_SECRET=replace-with-a-unique-32-character-audit-hmac-secret
AUDIT_IP_HASH_KEY_VERSION=v1
TENCENT_COS_BUCKET=facemini-agenthub-1234567890
TENCENT_COS_REGION=ap-guangzhou
# CAM sub-user credentials. Never commit real values. Production may instead set
# TENCENT_SECRET_ID_FILE and TENCENT_SECRET_KEY_FILE to mounted secret files.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
NEXT_PUBLIC_SITE_NAME=鲸创 AgentHub
NEXT_PUBLIC_SITE_DESCRIPTION=智能体应用发现平台
